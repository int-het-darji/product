{
  "name": "platform",
  "version": "1.0.0",
  "description": "This will contains all the backend of the platform ",
  "main": "index.js",
  "scripts": {
    "start:windows": "set NODE_ENV=development && ts-node-dev --poll index.ts",
    "start:ubuntu": "NODE_ENV=development ts-node-dev --poll index.ts",
    "start": "NODE_OPTIONS=--max_old_space_size=4096 node build/index.js",
    "build": "tsc --outDir build",
    "build:prod": "NODE_ENV=production tsc --outDir build",
    "dev": "ts-node-dev --poll index.ts",
    "dev:local": "ts-node-dev --no-notify --transpile-only --poll src/index.ts",
    "migration": "ts-node-dev --poll src/migration.ts",
    "add-permission": "ts-node-dev --poll src/scripts/add-permissions.ts",
    "create-bucket": "ts-node-dev --poll src/scripts/aws-bucket-creation.ts",
    "generate-forecast": "ts-node-dev --poll src/scripts/generate-forecasted-data.ts",
    "add-states-cities": "ts-node-dev --poll src/scripts/add-state-cities.ts"
  },
  "keywords": [
    "rp-forecasting"
  ],
  "author": "RP-forecasting",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.823.0",
    "@aws-sdk/s3-presigned-post": "^3.823.0",
    "@aws-sdk/s3-request-presigner": "^3.823.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "country-state-city": "^3.2.1",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.3",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "ts-node-dev": "^2.0.0",
    "useragent": "^2.3.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.19",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.2",
    "@types/useragent": "^2.3.4",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  }
}
