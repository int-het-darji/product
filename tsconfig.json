{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "build",
    "rootDir": ".",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "config/**/*.ts",
    "middleware/**/*.ts",
    "utils/**/*.ts",
    "interfaces/**/*.ts"
  ],
  "exclude": [
    "build",
    "node_modules"
  ]
}
